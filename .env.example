# ============================================
# REACT APP CONFIGURATION
# ============================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=development

# ============================================
# ONEMSG WHATSAPP API CONFIGURATION
# ============================================
# Get API credentials at: https://onemsg.com

# OneMsg API Base URL
# Production: https://api.onemsg.com/v1
# Sandbox/Testing: https://sandbox-api.onemsg.com/v1
REACT_APP_ONE_MSG_API_URL=https://api.onemsg.com/v1

# Your OneMsg API Key
# Get this from your OneMsg Dashboard
# Format: sk_live_xxxxxxxxxxxxxxxxxxxxx (production)
# Format: sk_test_xxxxxxxxxxxxxxxxxxxxx (sandbox)
REACT_APP_ONE_MSG_API_KEY=sk_test_your_api_key_here

# Your WhatsApp Business Account Phone Number
# Must be verified WhatsApp Business phone
# Format: +country_code + number (e.g., +1234567890)
REACT_APP_ONE_MSG_BUSINESS_PHONE=+1234567890

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
NODE_ENV=development
PORT=5000

# Database Connection
MONGODB_URI=mongodb://localhost:27017/rentpondy
DB_NAME=rentpondy

# AWS SNS Configuration (Optional - Fallback SMS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# OneMsg Backend Configuration
ONE_MSG_API_URL=https://api.onemsg.com/v1
ONE_MSG_API_KEY=sk_test_your_api_key_here
ONE_MSG_BUSINESS_PHONE=+1234567890

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_DELAY_SECONDS=30

# ============================================
# OPTIONAL: Feature Flags
# ============================================
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_SMS_FALLBACK=true
ENABLE_EMAIL_NOTIFICATIONS=false

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
